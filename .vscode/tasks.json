{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Tests offscreen",
            "type": "shell",
            "command": "/usr/bin/python3",
            "args": [
                "-m",
                "unittest",
                "discover",
                "-s",
                "tests",
                "-v"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "QT_QPA_PLATFORM": "offscreen"
                }
            },
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        }
    ]
}
